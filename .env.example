# STMS Root Environment Variables
# Copy to .env and fill in values

# ==================== APP ====================
NODE_ENV=development

# ==================== DATABASE ====================
MONGODB_URI=mongodb://localhost:27017/stms_dev
REDIS_URL=redis://localhost:6379

# ==================== FIREBASE AUTH ====================
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ==================== JWT (RS256) ====================
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RS256_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_RS256_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== CLOUDINARY (Media Storage) ====================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==================== FRONTEND URL (for emails) ====================
FRONTEND_URL=http://localhost:5173

# ==================== SENTRY (Error Tracking) ====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================== LOGGING ====================
LOG_LEVEL=debug