# STMS Frontend Environment Variables
# Copy to .env and fill in values

# ==================== API ====================
# Local development: Vite proxies /api to the backend below.
# For a production frontend, use the deployed backend URL (including /api/v1)
# or configure a hosting rewrite for /api.
VITE_API_URL=/api/v1
# Used by the Vite dev server only; keep this aligned with backend PORT.
VITE_API_PROXY_TARGET=http://localhost:5000

# ==================== FIREBASE ====================
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ==================== APP ====================
VITE_APP_NAME=STMS
# Set this to the deployed frontend origin in production.
VITE_APP_URL=http://localhost:5173
