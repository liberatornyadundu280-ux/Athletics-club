# STMS ML feature engineering / training / inference — environment template.
# Copy to .env (gitignored) and fill in real values. Never commit credentials.
# These values override the placeholders in stms_ml/config.yaml at load time.

# MongoDB (must point at the same database the backend writes to)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=stms_dev

# Redis Streams (inference queue)
REDIS_URL=redis://localhost:6379

# Cloudinary (model artifact storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
