# STMS Backend Environment Variables
# Copy to .env and fill in values

# ==================== APP ====================
NODE_ENV=development
PORT=5000

# ==================== DATABASE ====================
MONGODB_URI=mongodb://localhost:27017/stms_dev
# Local Redis. Use your provider's external connection URL when the backend runs outside that network.
REDIS_URL=redis://localhost:6379

# ==================== FIREBASE AUTH ====================
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=smart-trainer-ms
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smart-trainer-ms.iam.gserviceaccount.com
# Replace this with the complete `private_key` value from a Firebase service account JSON file.
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"
# ==================== JWT (RS256) ====================
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="replace-with-generated-rs256-private-key"
JWT_PUBLIC_KEY="replace-with-generated-rs256-public-key"

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== CLOUDINARY (Media Storage) ====================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==================== FRONTEND URL (for emails) ====================
FRONTEND_URL=http://localhost:5173

# ==================== SENTRY (Error Tracking) ====================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================== LOGGING ====================
LOG_LEVEL=debug
